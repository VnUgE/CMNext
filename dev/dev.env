##########
#  HTTP
##########

HTTP_BIND_ADDRESS=127.0.0.1
HTTP_BIND_PORT=8089
HTTP_MAX_CONS=100
HTTP_KEEPALIVE_MS=1000000
HTTP_TRACE_ON=true
HTTP_PORT_CHECK_ON=false
HTTP_HOSTNAME=*
HTTP_DOWNSTREAM_SERVERS=[]

MAX_CONTENT_LENGTH=52428800
COMPRESSION_ON=true
COMPRESSOR_ASM_PATH=lib/vnlib.net.compression/VNLib.Net.Compression.dll
COMPRESSION_MAX=512000
COMPRESSION_MIN=2048

# disable tls for dev server
TLS_ENABLE=false

##########
#  SQL
##########

SQL_LIB_PATH=VNLib.Plugins.Extensions.Sql.SQLite.dll
SQL_CONNECTION_STRING="Data Source=cmnext-debug.db;"

############
#  CACHE
############

CACHE_ASM_PATH=VNLib.Data.Caching.Providers.VNCache.dll

##############
#  SECRETS
##############

# disable the password pepper for debug database
PASSWORD_PEPPER_DISABLED=true

##########
#  STORAGE
##########

#override minio address
MINIO_ADDRESS=127.0.0.1:9000

STORAGE_TYPE=s3
STORAGE_SERVER_ADDRESS=127.0.0.1:9000
STORAGE_USERNAME=cmnextdev
STORAGE_SECRET=cmnextdev
STORAGE_BUCKET=cmnext
STORAGE_USE_SSL=false
S3_REGION=us-east-1

##############
#  CMNext
##############

DEBUG_PLUGINS=true
CHANNEL_INDEX_FILE=channels.json

# Debug username and password for first user setup
CMNEXT_DEBUG_USERNAME=cmnext@vaughnnugent.com
CMNEXT_DEBUG_PASSWORD=Test123!

# enable hot reload during debugging
PLUGINS_HOT_RELOAD=true

VNLIB_SHARED_HEAP_FILE_PATH=lib/vnlib_rpmalloc
VNLIB_COMPRESS_DLL_PATH=lib/vnlib_compress
VNLIB_ARGON2_DLL_PATH=lib/argon2