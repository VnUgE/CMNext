{
  //Enables debug logging
  "debug": ${DEBUG_PLUGINS:-false},

  "api": {
    "path": "/api/blog",
    "max_content_length": ${MAX_CONTENT_LENGTH:-5120000}, //5MB
  },

  "blog_channels": {
    //The index file for storing channel configuration
    "index_file_name": "${CHANNEL_INDEX_FILE:-blogs/channels.json}"
  },

  "storage": {

    "custom_storage_assembly": "${STORAGE_CUSTOM_ASSEMBLY}",

    "type": "${STORAGE_TYPE}", //s3 | ftp

    //storage config
    "server_address": "${STORAGE_SERVER_ADDRESS}",
    "bucket": "${STORAGE_BUCKET}",
    "use_ssl": ${STORAGE_USE_SSL:-false},

    //s3 keys
    "access_key": "${STORAGE_USERNAME}",
    "region": "${S3_REGION}",

    //ftp keys
    "username": "${STORAGE_USERNAME}",
    "keepalive_sec": ${FTP_KEEPALIVE_SEC:-0}
  },

  "secrets": {
    //Set the vault path to the s3 secret
    "storage_secret": "${STORAGE_SECRET}"
  }
}
