{
  //Enables debug logging
  "debug": false,

  "api": {
    "path": "/api/blog",
    "max_content_length": 60000000
  },

  "blog_channels": {
    //The index file for storing channel configuration
    "index_file_name": "blogs/channels.json"
  },

  "storage": {
    //The custom storage assembly to use
    "custom_storage_assembly": null,

    "type": "s3", //s3 | ftp

    "server_address": "",
    "bucket": "",
    "use_ssl": false,

    //s3 keys
    "access_key": "",
    "region": null,

    //ftp keys
    "username": "",
    "keepalive_sec": 0
  },

  "secrets": {
    //Set the vault path to the s3 secret
    "storage_secret": ""
  }
}
